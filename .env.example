# Create an API key at https://resend.com/api-keys and verify the sender domain first.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="TamilThadam <login@your-verified-domain.com>"

# Keep this value private and stable across restarts; use a long random string.
OTP_HASH_SECRET=replace-with-a-long-random-secret

# Render provides DATABASE_URL automatically when the existing PostgreSQL database is linked.

# Grant learner database access only to the named site accounts.
ADMIN_USERNAMES=your-admin-username
ADMIN_EMAILS=admin@example.com

# Optional private Google Sheet sync (never put this secret in frontend code).
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_SHEETS_SYNC_SECRET=replace-with-the-same-long-random-secret-set-in-Apps-Script
